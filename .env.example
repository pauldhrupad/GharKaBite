# Required
MONGODB_URI=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
CONTACT_EMAIL=

# Free-tier Cloudinary account; required only for new image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Free-tier Geoapify account and private kitchen center; required for delivery checks
GEOAPIFY_API_KEY=
# Separate browser-visible Geoapify key restricted to localhost and production domains
NEXT_PUBLIC_GEOAPIFY_MAPS_KEY=
KITCHEN_LATITUDE=
KITCHEN_LONGITUDE=
MAX_DELIVERY_RADIUS_KM=5

# Future live payments only; unused by the demo payment simulator
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
